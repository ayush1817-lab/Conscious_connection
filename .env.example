# Supabase project (Project Settings > API). For local dev, `npm run db:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used to build event and private host links in emails.
SITE_URL=http://localhost:3000

# Email. Leave RESEND_API_KEY empty to log emails to the console and the email_log table.
RESEND_API_KEY=
EMAIL_FROM="Conscious Connections <no-reply@consciousconnections.ie>"
# Optional. Where host replies go (emails say "you can reply to this email"), e.g. Karina's inbox.
EMAIL_REPLY_TO=

# Optional. Where admin notifications go (new requests, host edits, cancellations,
# contact requests). Comma-separated. If empty, every admin login's email is used.
ADMIN_NOTIFY_EMAIL=

# Once people have registered, hosts can't change date, times, county or address.
# Set to false to allow it (spec section 9; still being confirmed).
LOCK_KEY_FIELDS_WHEN_REGISTERED=true

# Protects the daily data-retention route (/api/cron/retention).
CRON_SECRET=

# Used by `npm run seed` to create the first admin login.
SEED_ADMIN_EMAIL=karina@consciousconnections.ie
SEED_ADMIN_PASSWORD=
